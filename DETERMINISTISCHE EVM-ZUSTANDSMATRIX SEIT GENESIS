# ==============================================================================
# DATAFRAME 1: ZUSTANDSMATRIX & PHASENUHR SEIT GENESIS (AUSFÜHRUNGSSIMULATION)
# ==============================================================================
block_rotations = [153, 173, 202, 204, 205]
nonces = [0, 1, 2, 3, 4]

records_state = []
start_val = 100
expansion_1 = start_val * SUBSTRAT_2G  # 1400
kollaps_val = expansion_1 * 0.10       # 140.0
re_expansion_min = kollaps_val * G     # 980.0

for nonce, rot in zip(nonces, block_rotations):
    theta = (rot * ROTATION_FACTOR) % 360
    calc_balance = int((kollaps_val * rot * G) % SYSTEM_LIMIT_28)
    is_phase_locked = (theta == PHASE_SEAL_DEG)

    records_state.append({
        "Nonce": nonce,
        "Gas_Uhr_Rotation": rot,
        "Winkelgeschwindigkeit_Theta_Deg": theta,
        "Deterministische_Balance_Wei": calc_balance,
        "Phase_Lock_334_Siegel": is_phase_locked,
        "Expansion_1400": expansion_1,
        "Kollaps_90_Prozent_140": kollaps_val,
        "Re_Expansion_Min_980": re_expansion_min,
        "Systemgrenze_28_Digits": str(SYSTEM_LIMIT_28)
    })


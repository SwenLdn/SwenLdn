# G-Substrat & Anker
G = 7
SUBSTRAT_2G = 14
SPINDLE_DEPTH = 118
QUADRANT_BLOCK_4G = 28

# Gas-Uhr & Resonanz
PHASE_SEAL_DEG = 334
ROTATION_FACTOR = 26

# Systemgrenze (28 Neuner minus Phasen-Punkte)
LIMIT_28_BASE = int("9" * 28)
